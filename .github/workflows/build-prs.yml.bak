name: Build and test PRs
on:
  push:
  pull_request:
    types:
      - synchronize
      - opened
      - ready_for_review
      - reopened
  workflow_dispatch: 
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1000
          fetch-tags: true
          # 保留历史、授权推送分支
          persist-credentials: true

      # GradleUtils will append the branch name to the version,
      # but for that we need a properly checked out branch
      - name: Create branch for commit
        run:
          git switch -C pr-${{ github.event.pull_request.number }}-${{ github.event.pull_request.head.ref }}

      - name: Setup JDK 17
        uses: actions/setup-java@v2
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup with Gradle
        run: sh gradlew setup

      - name: Build with Gradle
        run: sh gradlew build

      # ========== 新增：推送所有文件到 out 分支 ==========
      - name: Push all files to out branch (create if not exists)
        run: |
          # 配置 git 用户名/邮箱
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          # 强制添加所有文件（包含新增/修改/删除）
          git add --all
          # 提交变更
          git commit -m "Auto commit from CI build" || echo "No changes to commit"
          # 强制推送到 out 分支，不存在则创建
          git push -f origin HEAD:out

      - uses: actions/upload-artifact@v4
        with:
         name: project
         path: .
      - uses: actions/upload-artifact@v4
        with:
         name: mcbig
         path: ./projects/mcbig
      - uses: actions/upload-artifact@v4
        with:
         name: jar
         path: ./projects/mcbig/build/libs/*
